# Copy to .env.local and fill in. Never commit .env.local.
# /api/identify recognises cars from customer photos with one of two AI providers.

# Which provider to use: "gemini" or "anthropic".
# If unset: Gemini when GEMINI_API_KEY is set, otherwise Claude.
AI_PROVIDER=

# Google Gemini (free tier available: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional: comma-separated models to try in order when one is busy or out of quota
# (default: gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite)
GEMINI_MODEL=

# Anthropic Claude (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# "See it for real" (/visualize) edits a real photo with a Gemini image model. Each image is billed.
# Optional: comma-separated image models to try in order (default: gemini-3.1-flash-image,gemini-2.5-flash-image)
GEMINI_IMAGE_MODEL=
# Optional: most photos this server will generate per hour (default: 20)
VISUALIZE_HOURLY_LIMIT=
